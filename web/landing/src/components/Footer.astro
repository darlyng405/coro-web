---
import { SITE } from '../config/site';
---
<footer class="footer">
  <div class="container">
    <div class="footer__grid">
      <div class="footer__brand">
        <img src="/logotipo.jpg" alt="CORO" />
        <p class="footer__tagline">Que ninguna voz se quede fuera del coro.</p>
      </div>
      <div class="footer__col">
        <h4>Plataforma</h4>
        <ul>
          <li><a href="#que-es">Qué es CORO</a></li>
          <li><a href="#como-funciona">Cómo funciona</a></li>
          <li><a href="#ods">ODS</a></li>
          <li><a href="#descargar">Descargar</a></li>
        </ul>
      </div>
      <div class="footer__col">
        <h4>Proyecto</h4>
        <ul>
          <li><a href="#equipo">Equipo</a></li>
          <li><a href="#proposito">Propósito y visión</a></li>
          <li><a href="/manual">Manual del Ciudadano</a></li>
          <li><a href="/privacidad">Privacidad</a></li>
          <li><a href="/terminos">Términos</a></li>
        </ul>
      </div>
      <div class="footer__col">
        <h4>Contacto</h4>
        <ul>
          <li><a href={`mailto:${SITE.contact.generalEmail}`}>{SITE.contact.generalEmail}</a></li>
          <li><a href={`tel:${SITE.contact.darlyngPhone.replace(/\s+/g, '')}`}>{SITE.contact.darlyngPhone}</a></li>
        </ul>
      </div>
    </div>
    <div class="footer__bottom">
      <p>© 2026 CORO — Proyecto de participación ciudadana juvenil.</p>
    </div>
  </div>
</footer>
